# RelayPanel runtime configuration. This file is read by relaypanel.service.
# Generate secrets with:
#   openssl rand -hex 32    # JWT_SECRET
#   openssl rand -hex 16    # PANEL_KEY

# SQLite is the default. The package creates /var/lib/relay-panel for it.
DATABASE_URL=sqlite:/var/lib/relay-panel/data.db?mode=rwc
LISTEN=127.0.0.1:18888
PUBLIC_DIR=/usr/share/relay-panel/public

# Required before the service can start. JWT_SECRET must be at least 32 bytes.
JWT_SECRET=
PANEL_KEY=

# Optional: used only on first database initialization (8-72 bytes).
ADMIN_INITIAL_PASSWORD=

# Set this when using Nginx/Caddy and a public domain.
PUBLIC_PANEL_URL=

# Defaults shown explicitly for operators.
REGISTRATION_ENABLED=false
GEOIP_ENABLED=false
GEOIP_CACHE_TTL=604800
RUST_LOG=info
