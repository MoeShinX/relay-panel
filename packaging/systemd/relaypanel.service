[Unit]
Description=RelayPanel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relaypanel
Group=relaypanel
EnvironmentFile=/etc/relay-panel/relay-panel.env
ExecStart=/usr/bin/relay-panel
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/relay-panel

[Install]
WantedBy=multi-user.target
